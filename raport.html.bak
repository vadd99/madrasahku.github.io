<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buku Induk Raport - AL-HADI</title>
    
    <link rel="stylesheet" href="css/style-base.css">
    <link rel="stylesheet" href="css/style-layout.css">
    <link rel="stylesheet" href="css/style-components.css">
    <link rel="stylesheet" href="css/style-raport.css"> <!-- CSS Khusus Raport -->

    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="dark">
    <div id="layout-wrapper"></div>
    
    <template id="page-content">
        <div class="raport-page-container">
            <div class="page-toolbar">
                <!-- Header Card -->
                <div class="toolbar-info page-header-card">
                    <div class="header-content-flex">
                        <button id="btn-back-kelas" class="btn-back hidden" onclick="goBackToKelasList()" title="Kembali">
                            <i data-lucide="arrow-left"></i>
                        </button>
                        
                        <div class="header-icon-wrapper raport-icon">
                            <i data-lucide="book-open"></i>
                        </div>
                        <div class="header-text-wrapper">
                            <h2 class="page-title" id="page-title">Buku Induk Raport</h2>
                            <p class="page-subtitle" id="page-subtitle">Pilih kelas untuk melihat rekapitulasi nilai dalam bentuk tabel.</p>
                        </div>
                    </div>
                </div>

                <!-- Selector Periode & Tombol Export -->
                <div id="raport-selectors" class="selectors-container" style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <div class="raport-selector-wrapper" style="flex: 1; min-width: 200px;">
                        <label for="select-periode-raport"><i data-lucide="calendar" style="width: 14px; height: 14px;"></i> Periode Ujian</label>
                        <select id="select-periode-raport" class="form-input-sm" onchange="changePeriode(this.value)">
                            <option value="Imtihan 1">Imtihan 1 (Ganjil)</option>
                            <option value="Imtihan 2">Imtihan 2 (Genap)</option>
                        </select>
                    </div>
                    <div id="export-container" class="hidden" style="display: flex; align-items: flex-end;">
                        <button class="btn btn-save-active" onclick="exportToExcel()" style="padding: 8px 15px; font-size: 0.9rem;">
                            <i data-lucide="download" style="width: 16px; height: 16px;"></i> Export Excel
                        </button>
                    </div>
                </div>
            </div>

            <div class="raport-content-card">
                <!-- Tampilan Daftar Kelas -->
                <div id="view-kelas">
                    <div id="empty-state-kelas" class="empty-state hidden">
                        <div class="empty-icon-wrapper"><i data-lucide="school"></i></div>
                        <h3 class="empty-title">Belum Ada Data Kelas</h3>
                        <p class="empty-desc">Tambahkan kelas terlebih dahulu pada menu Data Santri.</p>
                    </div>
                    <div id="kelas-grid-container" class="kelas-grid hidden"></div>
                </div>

                <!-- Tampilan Tabel Raport -->
                <div id="view-tabel" class="hidden">
                    <div id="loading-state" class="empty-state hidden">
                        <i data-lucide="loader-2" class="animate-spin"></i>
                        <p>Menyiapkan tabel induk raport...</p>
                    </div>
                    
                    <div class="table-responsive-wrapper" id="tabel-container">
                        <!-- Tabel akan di-inject oleh JS di sini -->
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Script library untuk export ke excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="js/main.js"></script>
    <script type="module" src="js/raport.js"></script>
</body>
</html>
