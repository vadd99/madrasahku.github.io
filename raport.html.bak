<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buku Induk Raport - AL-HADI</title>
    
    <!-- Memuat semua CSS core & layout -->
    <link rel="stylesheet" href="css/style-base.css">
    <link rel="stylesheet" href="css/style-layout.css">
    <link rel="stylesheet" href="css/style-components.css">
    
    <!-- Memuat CSS Absensi & Rekap untuk struktur container & grid yang sudah terbukti rapi -->
    <link rel="stylesheet" href="css/style-absensi.css">
    <link rel="stylesheet" href="css/style-rekap.css">
    <link rel="stylesheet" href="css/style-nilai.css"> 
    
    <!-- CSS Khusus untuk desain Tabel Raport -->
    <link rel="stylesheet" href="css/style-raport.css">

    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="dark">
    <div id="layout-wrapper"></div>
    
    <template id="page-content">
        <!-- MENGGUNAKAN CLASS DARI ABSENSI AGAR SCROLL & LEBAR DESKTOP BERFUNGSI NORMAL -->
        <div class="absensi-page-container">
            
            <div class="page-toolbar">
                <!-- Header Card -->
                <div class="toolbar-info page-header-card">
                    <div class="header-content-flex">
                        <button id="btn-back-kelas" class="btn-back hidden" onclick="goBackToKelasList()" title="Kembali">
                            <i data-lucide="arrow-left"></i>
                        </button>
                        
                        <div class="header-icon-wrapper raport-icon">
                            <i data-lucide="book-open"></i>
                        </div>
                        <div class="header-text-wrapper">
                            <h2 class="page-title" id="page-title">Buku Induk Raport</h2>
                            <p class="page-subtitle" id="page-subtitle">Pilih kelas untuk melihat rekapitulasi nilai dalam bentuk tabel.</p>
                        </div>
                    </div>
                </div>

                <!-- Selector Periode & Tombol Export -->
                <div id="raport-selectors" class="selectors-container" style="display: flex; gap: 15px; flex-wrap: wrap;">
                    
                    <div class="raport-selector-card" style="flex: 1; min-width: 200px;">
                        <label for="select-periode-raport" class="selector-label">
                            <i data-lucide="calendar" style="width: 16px; height: 16px;"></i> Periode Ujian
                        </label>
                        <select id="select-periode-raport" class="form-input-sm" onchange="changePeriode(this.value)">
                            <option value="Imtihan 1">Imtihan 1 (Ganjil)</option>
                            <option value="Imtihan 2">Imtihan 2 (Genap)</option>
                        </select>
                    </div>

                    <div id="export-container" class="hidden raport-selector-card" style="flex: 0 1 auto; justify-content: flex-end; padding: 10px 15px;">
                        <button class="btn btn-save-active" onclick="exportToExcel()" style="height: 100%; min-height: 38px; padding: 0 20px; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                            <i data-lucide="download" style="width: 18px; height: 18px;"></i> Export Excel
                        </button>
                    </div>

                </div>
            </div>

            <div class="absensi-content-card">
                
                <!-- Tampilan Daftar Kelas -->
                <div id="view-kelas">
                    <div id="empty-state-kelas" class="empty-state hidden">
                        <div class="empty-icon-wrapper"><i data-lucide="school"></i></div>
                        <h3 class="empty-title">Belum Ada Data Kelas</h3>
                        <p class="empty-desc">Tambahkan kelas terlebih dahulu pada menu Data Santri.</p>
                    </div>
                    
                    <div id="kelas-grid-container" class="kelas-grid hidden"></div>
                </div>

                <!-- Tampilan Tabel Raport -->
                <div id="view-tabel" class="hidden">
                    <div id="loading-state" class="empty-state hidden">
                        <i data-lucide="loader-2" class="animate-spin"></i>
                        <p>Menyiapkan tabel induk raport...</p>
                    </div>
                    
                    <!-- NEW: Toolbar Table (Full Screen Button) -->
                    <div id="tabel-toolbar" class="hidden" style="display: flex; justify-content: flex-end; margin-bottom: 12px;">
                        <button onclick="toggleFullscreen()" class="btn btn-save-active" style="padding: 8px 16px; font-size: 0.85rem; border-radius: 8px; display: flex; align-items: center; gap: 6px; background-color: #3b82f6; border-color: #3b82f6; color: white; box-shadow: 0 2px 4px rgba(59,130,246,0.3);">
                            <i data-lucide="maximize" style="width: 16px; height: 16px;"></i> Full Screen
                        </button>
                    </div>
                    
                    <!-- NEW: Wrapper Fullscreen -->
                    <div id="fullscreen-wrapper">
                        <!-- Tombol Tutup (Hanya muncul saat Fullscreen aktif) -->
                        <button id="btn-close-fs" onclick="toggleFullscreen()" class="btn-close-fs hidden">
                            <i data-lucide="x" style="width: 18px; height: 18px;"></i> Tutup
                        </button>
                        
                        <div class="table-responsive-wrapper" id="tabel-container">
                            <!-- Tabel akan di-inject oleh JS di sini -->
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </template>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="js/main.js"></script>
    <script type="module" src="js/raport.js"></script>
</body>
</html>
