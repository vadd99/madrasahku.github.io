<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekap Imtihan Santri - AL-HADI</title>
    
    <link rel="stylesheet" href="css/style-base.css">
    <link rel="stylesheet" href="css/style-layout.css">
    <link rel="stylesheet" href="css/style-components.css">
    <link rel="stylesheet" href="css/style-absensi.css">
    <link rel="stylesheet" href="css/style-rekap.css">
    <link rel="stylesheet" href="css/style-nilai.css"> 
    <link rel="stylesheet" href="css/style-imtihan.css"> <!-- CSS Baru -->

    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="dark">
    <div id="layout-wrapper"></div>
    <template id="page-content">
        <div class="absensi-page-container">
            <div class="page-toolbar">
                
                <!-- Header Card -->
                <div class="toolbar-info page-header-card">
                    <div class="header-content-flex">
                        <button id="btn-back-kelas" class="btn-back hidden" onclick="goBackToKelasList()" title="Kembali">
                            <i data-lucide="arrow-left"></i>
                        </button>
                        
                        <div class="header-icon-wrapper imtihan-icon">
                            <i data-lucide="award"></i>
                        </div>
                        <div class="header-text-wrapper">
                            <h2 class="page-title" id="page-title">Rekap Nilai Imtihan</h2>
                            <p class="page-subtitle" id="page-subtitle">Pilih kelas untuk melihat rekapitulasi nilai akhir santri.</p>
                        </div>
                    </div>
                </div>

                <!-- Selector Periode -->
                <div id="imtihan-selectors" class="selectors-container">
                    <div class="imtihan-selector-wrapper" style="width: 100%;">
                        <label for="select-periode-imtihan"><i data-lucide="calendar" style="width: 14px; height: 14px;"></i> Periode Ujian</label>
                        <select id="select-periode-imtihan" class="form-input-sm" onchange="changePeriode(this.value)">
                            <option value="Imtihan 1">Imtihan 1 (Ganjil)</option>
                            <option value="Imtihan 2">Imtihan 2 (Genap)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="absensi-content-card">
                <!-- Tampilan Daftar Kelas -->
                <div id="view-kelas">
                    <div id="empty-state-kelas" class="empty-state hidden">
                        <div class="empty-icon-wrapper"><i data-lucide="school"></i></div>
                        <h3 class="empty-title">Belum Ada Data Kelas</h3>
                        <p class="empty-desc">Tambahkan kelas terlebih dahulu pada menu Data Santri.</p>
                    </div>
                    <div id="kelas-grid-container" class="kelas-grid hidden"></div>
                </div>

                <!-- Tampilan Daftar Santri -->
                <div id="view-santri" class="hidden">
                    <div id="guide-box-imtihan" class="absensi-guide-box">
                        <div class="guide-icon"><i data-lucide="info"></i></div>
                        <div class="guide-text">
                            <strong>Panduan Nilai Imtihan:</strong>
                            <p>Klik nama santri untuk melihat rincian Rata-rata Ulangan Harian (UH) dan menginput <b>Nilai Ujian Imtihan</b> per Mata Pelajaran.</p>
                        </div>
                        <button class="btn-close-guide" onclick="closeGuideBoxImtihan()" title="Tutup Panduan">
                            <i data-lucide="x" style="width: 18px; height: 18px;"></i>
                        </button>
                    </div>

                    <div id="santri-imtihan-container" class="absensi-list-grid">
                        <!-- Diisi oleh JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL DETAIL & INPUT IMTIHAN PER SANTRI -->
        <div id="modal-detail-imtihan" class="modal-overlay">
            <div class="modal-card modal-lg modal-imtihan">
                <div class="modal-header">
                    <div class="modal-header-title">
                        <i data-lucide="file-spreadsheet" class="modal-header-icon"></i>
                        <div>
                            <h3 id="modal-santri-nama">Nama Santri</h3>
                            <p class="modal-santri-kelas text-date-badge" id="modal-kelas-text">Kelas</p>
                        </div>
                    </div>
                    <button class="btn-close-modal" onclick="closeModalImtihan()">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                
                <div class="modal-body imtihan-modal-body">
                    <!-- Grand Total Sticky Banner -->
                    <div class="grand-total-banner">
                        <div class="gt-left">
                            <span class="gt-label">Rata-rata Keseluruhan (Semua Mapel)</span>
                        </div>
                        <div class="gt-right">
                            <span class="gt-value" id="grand-total-value">0.00</span>
                        </div>
                    </div>

                    <div id="mapel-cards-container">
                        <!-- Card per mapel akan di-inject lewat JS -->
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" onclick="closeModalImtihan()">Tutup</button>
                    <button type="button" id="btn-save-imtihan" class="btn btn-save-active" onclick="simpanNilaiImtihan()">
                        <i data-lucide="save" style="width: 16px; height: 16px;"></i> Simpan Nilai Imtihan
                    </button>
                </div>
            </div>
        </div>

        <!-- MODAL SUKSES -->
        <div id="modal-success-alert" class="modal-overlay">
            <div class="modal-card modal-sm text-center">
                <div class="success-icon-wrapper">
                    <i data-lucide="check-circle"></i>
                </div>
                <h3 class="success-title">Berhasil!</h3>
                <p id="success-message" class="success-message">Nilai Imtihan berhasil disimpan.</p>
                <div class="modal-footer" style="justify-content: center; border-top: none; margin-top: 5px;">
                    <button type="button" class="btn btn-save-active" onclick="closeSuccessModal()" style="width: 100%;">Oke, Mengerti</button>
                </div>
            </div>
        </div>
    </template>

    <script src="js/main.js"></script>
    <script type="module" src="js/imtihan.js"></script>
</body>
</html>
