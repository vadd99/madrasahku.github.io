
/* =========================================================
   STYLE KHUSUS REKAP IMTIHAN - EDISI RAPORT
   ========================================================= */

.header-icon-wrapper.imtihan-icon {
    background: rgba(245, 158, 11, 0.15); /* Warna Amber/Emas */
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
}

/* Modal Imtihan (Lebih besar) */
.modal-lg.modal-imtihan {
    max-width: 600px;
    width: 95%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
}

.imtihan-modal-body {
    overflow-y: auto;
    padding: 15px;
    background: #f8fafc;
}

body.dark .imtihan-modal-body {
    background: var(--bg-body);
}

/* Grand Total Banner (Menyesuaikan Raport) */
.grand-total-banner {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    position: sticky;
    top: 0;
    z-index: 10;
}

.gt-label {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.9;
}

.gt-value {
    font-size: 1.8rem;
    font-weight: 800;
}

/* Mapel Card */
.mapel-imtihan-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 15px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}

body.dark .mapel-imtihan-card {
    background: var(--bg-main);
    border-color: var(--border-color);
}

.mapel-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    border-bottom: 1px dashed #e2e8f0;
    padding-bottom: 10px;
}

body.dark .mapel-card-header {
    border-bottom-color: var(--border-color);
}

.mapel-card-header h4 {
    margin: 0;
    font-size: 1.1rem;
    color: #1e293b;
    flex: 1;
}

body.dark .mapel-card-header h4 { color: #fff; }

/* Grid Statistik per Mapel (Disesuaikan untuk Raport) */
.imtihan-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.5fr; /* Kolom huruf dibuat agak lebar */
    gap: 10px;
}

@media (max-width: 480px) {
    .imtihan-stats-grid {
        grid-template-columns: repeat(2, 1fr); 
    }
}

.stat-box {
    background: #f1f5f9;
    border-radius: 8px;
    padding: 10px 5px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid transparent;
}

body.dark .stat-box {
    background: rgba(255,255,255,0.03);
    border-color: rgba(255,255,255,0.05);
}

.stat-box.highlight {
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.3);
}

.stat-box.highlight-huruf {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
}

.stat-label {
    font-size: 0.65rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 4px;
}

body.dark .stat-label { color: #94a3b8; }

.stat-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1e293b;
}

.stat-value-sm {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.2;
}

body.dark .stat-value, body.dark .stat-value-sm { color: #e2e8f0; }

.stat-value.highlight-text {
    color: #10b981;
}

.highlight-text-huruf {
    color: #d97706;
}

/* Input Imtihan */
.input-imtihan-wrapper {
    margin-top: 4px;
}

.input-imtihan {
    width: 100%;
    text-align: center;
    font-size: 1.1rem;
    font-weight: 700;
    padding: 6px;
    border: 2px solid #cbd5e1;
    border-radius: 6px;
    color: #3b82f6;
    background: white;
    transition: 0.2s;
}

body.dark .input-imtihan {
    background: var(--bg-body);
    border-color: #475569;
    color: #60a5fa;
}

.input-imtihan:focus {
    border-color: #3b82f6;
    outline: none;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

/* Badge Rata-rata di Daftar Santri */
.badge-rata-rata {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    padding: 4px 10px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.8rem;
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    gap: 4px;
}

/* Raport Summary Card (Bagian Bawah) */
.raport-summary-card {
    background: #f8fafc;
    border: 1px dashed #94a3b8;
    border-radius: 12px;
    padding: 15px;
    margin-top: 20px;
}

body.dark .raport-summary-card {
    background: rgba(0,0,0,0.2);
    border-color: #475569;
}

.raport-summary-card h4 {
    margin-top: 0;
    margin-bottom: 15px;
    font-size: 1rem;
    color: #334155;
    display: flex;
    align-items: center;
    gap: 8px;
}

body.dark .raport-summary-card h4 { color: #cbd5e1; }

.summary-flex {
    display: flex;
    gap: 15px;
}

.sum-item {
    flex: 1;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

body.dark .sum-item {
    background: var(--bg-main);
    border-color: var(--border-color);
}

.sum-label {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 600;
}

.sum-val {
    font-size: 1.2rem;
    font-weight: 800;
    color: #10b981;
}
